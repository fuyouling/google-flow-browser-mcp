{
  "name": "google-flow-browser-mcp",
  "version": "1.0.0",
  "description": "MCP server for Google Flow (labs.google/fx/tools/flow) via browser automation",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "browser": "node scripts/start-browser.mjs",
    "test": "node scripts/test-e2e.mjs",
    "test:image": "powershell -ExecutionPolicy Bypass -File scripts/test-flow-image.ps1",
    "discover": "node scripts/test-e2e.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.9.0",
    "playwright": "^1.51.0",
    "zod": "^3.24.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
